# Copy this file to `.env` and replace the placeholders.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
DEEPL_API_KEY="your_deepl_api_key"

# ── Cloudflare Turnstile (formulaire de contact) ──
# Optionnel en dev local (vérification ignorée avec warning).
# Requis en production : crée un widget sur https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ── GitHub (carte activité) ──
# Pseudo affiché et interrogé via l'API publique. Cache 1h côté serveur.
GITHUB_USERNAME="mahunaromaric"
# Optionnel : augmente le quota API (60 → 5000 req/h).
GITHUB_TOKEN=""
# ── Réseau ──
# Nombre de proxys de confiance entre internet et l'app (pour l'IP réelle : x-real-ip puis XFF).
TRUSTED_PROXIES="1"

# ── Stockage médias S3 (prod) ──
# Si absents : stockage local dans public/uploads/ (dev).
# Si présents : upload vers le bucket S3-compatible (AWS, R2, Scaleway…).
# Le bucket doit être public en lecture (policy) — aucune ACL n'est posée (incompatible R2).
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optionnelles :
S3_REGION="auto"
S3_PUBLIC_URL=""
